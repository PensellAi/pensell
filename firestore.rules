rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    // إيميلات أصحاب الشركة — لازم تطابق OWNER_EMAILS في index.html
    function isOwner() { return signedIn() && myEmail() in ['ahmedassemads@gmail.com']; }
    function roles() { return get(/databases/$(database)/documents/cfg/roles).data; }
    function isTL() {
      return isOwner() || (signedIn()
        && exists(/databases/$(database)/documents/cfg/roles)
        && myEmail() in roles().get('tl', []));
    }
    function isEmp(id) {
      return signedIn()
        && exists(/databases/$(database)/documents/employees/$(id))
        && get(/databases/$(database)/documents/employees/$(id)).data.get('email', '') == myEmail();
    }

    match /cfg/{doc}        { allow read: if signedIn(); allow write: if isOwner(); }
    match /employees/{id}   { allow read: if isTL() || (signedIn() && resource.data.get('email', '') == myEmail());
                              allow write: if isOwner(); }
    match /clients/{id}     { allow read: if isTL(); allow write: if isOwner(); }
    match /fin/{rest=**}    { allow read, write: if isOwner(); }
    // الفريلانس: التيم ليدر بيسجّل ويشوف الشغلانات كمان
    match /fin/main/freelance/{id} { allow read, write: if isTL(); }
    // العملاء الخارجيين (شغل فريلانس لعميل مش من عملاء الشركة)
    match /extClients/{id}  { allow read, write: if isTL(); }
    // طلبات الأكونتات: اللي في القايمة (الطالب، والمطلوب منه، وكريتورز الأكونت) بس اللي يشوفوا الطلب
    match /reqs/{id} {
      allow read: if isTL() || (signedIn() && myEmail() in resource.data.see);
      allow create: if isTL() || (inTeam() && request.resource.data.byEmail == myEmail() && myEmail() in request.resource.data.see && request.resource.data.status == 'pending');
      allow update: if isTL() || (signedIn() && myEmail() in resource.data.see && (
                       (myEmail() == resource.data.toEmail && resource.data.status in ['todo','changes'] && request.resource.data.status == 'review'
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliver','dLinks','dNote','status','upAt']))
                    || (myEmail() == resource.data.byEmail && resource.data.status == 'pending' && request.resource.data.status == 'pending'
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['refs','links','upAt']))));
      allow delete: if isTL() || (signedIn() && myEmail() == resource.data.byEmail && resource.data.status == 'pending');
    }
    // عروض «فصّل باقتك» من الموقع: أي حد يبعت عرض، واللي معاه لينك العرض (الـ id) بس اللي يفتحه
    match /offers/{id} {
      allow get: if true;
      allow list, delete: if isTL();
      allow create: if request.resource.data.keys().hasOnly(['biz','link','loc','svc','plat','posts','price','ads','name','phone','status','at'])
                    && request.resource.data.status == 'new' && request.resource.data.at == request.time
                    && request.resource.data.biz is string && request.resource.data.biz.size() > 0 && request.resource.data.biz.size() <= 100
                    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
                    && request.resource.data.phone is string && request.resource.data.phone.size() >= 8 && request.resource.data.phone.size() <= 20
                    && request.resource.data.price is number && request.resource.data.price > 0 && request.resource.data.price < 10000000
                    && request.resource.data.svc is map && request.resource.data.plat is list && request.resource.data.plat.size() <= 10;
      // العميل بيوافق ويحجز ميعاد: لازم العرض متبعت ولسه ماخلصش، والميعاد اتحجز في نفس اللحظة
      allow update: if isTL() || (resource.data.status == 'sent' && request.time < resource.data.expiresAt
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','slot','acceptedAt'])
                    && request.resource.data.status == 'accepted' && request.resource.data.acceptedAt == request.time
                    && request.resource.data.slot is string
                    && !exists(/databases/$(database)/documents/slots/$(request.resource.data.slot))
                    && existsAfter(/databases/$(database)/documents/slots/$(request.resource.data.slot)));
    }
    // مواعيد الميتنجات المحجوزة: الكل يشوفها علشان الميعاد المحجوز مايتختارش تاني
    match /slots/{k}        { allow read: if true;
                              allow create: if k.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}$') && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
                              allow update, delete: if isTL(); }
    // شات الموقع: الزائر بيكتب في محادثته (لينكها سري)، والمدير بيرد
    match /siteChats/{cid} {
      allow get: if true;
      allow list, delete: if isTL();
      allow create: if cid.size() >= 20 && request.resource.data.keys().hasOnly(['name','phone','at','last','lastFrom','unread'])
                    && request.resource.data.name is string && request.resource.data.name.size() <= 60
                    && request.resource.data.phone is string && request.resource.data.phone.size() <= 20 && request.resource.data.lastFrom == 'c';
      allow update: if isTL() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['at','last','lastFrom','unread'])
                    && request.resource.data.lastFrom == 'c' && request.resource.data.last is string && request.resource.data.last.size() <= 200);
      match /msgs/{mid} {
        allow read: if true;
        allow create: if (request.resource.data.keys().hasOnly(['t','from','at']) && request.resource.data.from == 'c'
                          && request.resource.data.t is string && request.resource.data.t.size() > 0 && request.resource.data.t.size() <= 1000
                          && request.resource.data.at == request.time) || (isTL() && request.resource.data.from == 'a');
        allow delete: if isTL();
      }
    }
    match /attendance/{id}  { allow read, write: if isTL(); }
    match /checkins/{id}    { allow read: if isTL() || isEmp(id);
                              allow write: if isOwner() || isEmp(id); }

    // توزيع الأكونتات: التيم ليدر والمدير بس
    match /assign/{id}      { allow read, write: if isTL(); }
    // أكونتات كل موظف (بيتحدّث مع التوزيع) — الموظف بيقرا بتاعه بس
    match /mine/{id}        { allow read: if isTL() || isEmp(id); allow write: if isTL(); }
    // المهام والرسايل: الموظف بيقرا بتاعه وبيعلّم على المهام بس
    match /tasks/{id}       { allow read: if resource == null || isTL() || isEmp(resource.data.emp);
                              allow create, delete: if isTL();
                              allow update: if isTL() || (isEmp(resource.data.emp)
                                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items','msgSeen'])); }
    // التقييم: التيم ليدر بيكتب تقييمه بس، والمدير بيكتب الاتنين
    match /ratings/{id}     { allow read: if isTL();
                              allow write: if isOwner() || (isTL() && id.matches('.*_tl')); }
    // نجم الشهر: الكل بيشوفه، والمدير بس اللي بيعلنه
    match /stars/{id}       { allow read: if signedIn(); allow write: if isOwner(); }
    // ملخص الشهر (تعديلات المدير والتيم ليدر) وأرقام التصوير اللي المدير بيحسبها
    match /summary/{id}     { allow read, write: if isTL(); }
    match /stats/{id}       { allow read: if isTL(); allow write: if isOwner(); }
    // الشات: الجروب العام والرسايل الخاصة — كل محادثة بيقراها اللي إيميلهم فيها بس
    match /chats/{cid} {
      allow read: if signedIn() && (resource == null || myEmail() in resource.data.emails);
      allow create: if isOwner() || (signedIn() && cid.matches('dm_.*')
                     && myEmail() in request.resource.data.emails && request.resource.data.emails.size() == 2);
      allow update: if isOwner() || (signedIn() && myEmail() in resource.data.emails
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last']));
      allow delete: if isOwner();
      match /msgs/{mid} {
        allow read: if signedIn() && myEmail() in get(/databases/$(database)/documents/chats/$(cid)).data.emails;
        allow create: if signedIn() && myEmail() in get(/databases/$(database)/documents/chats/$(cid)).data.emails
                       && request.resource.data.fromEmail == myEmail();
        allow delete: if isOwner() || (signedIn() && resource.data.fromEmail == myEmail());
      }
    }
    // «فيه حاجة واقفة معاك؟»: كل موظف بيكتب في ملفه، والمدير والتيم ليدر بيشوفوا الكل
    function inTeam() { return signedIn() && myEmail() in get(/databases/$(database)/documents/chats/team).data.emails; }
    // بريف الأكونت: التيم كله بيقراه، والمدير والتيم ليدر بيكتبوه
    match /briefs/{cid}     { allow read: if inTeam() || isTL(); allow write: if isTL(); }
    // طلبات تعديل البريف: أي حد في التيم يبعت، والمدير والتيم ليدر بيشوفوا ويقفلوا
    match /briefReq/{id}    { allow create: if inTeam() && request.resource.data.email == myEmail();
                              allow read, update, delete: if isTL(); }
    // تقرير الشهر: الكريتور بيكتب تقريره، والمدير والتيم ليدر بيشوفوا الكل
    match /reports/{id}     { allow read: if isTL() || (signedIn() && (resource == null || resource.data.email == myEmail()));
                              allow write: if isTL() || (inTeam() && request.resource.data.email == myEmail() && (resource == null || resource.data.email == myEmail())); }
    // خطة الشهر: مشتركة بين الكريتور والتيم ليدر، والتقييم للمدير والتيم ليدر بس
    match /plans/{id}       { allow read: if inTeam() || isTL();
                              allow create: if isTL() || (inTeam() && !('rating' in request.resource.data));
                              allow update: if isTL() || (inTeam() && request.resource.data.get('rating', 0) == resource.data.get('rating', 0)); }
    // شغل مقترح للموقع: أي حد في التيم يبعت، والمدير بيوافق أو يرفض
    match /workSubs/{id}    { allow create: if inTeam() && request.resource.data.email == myEmail() && request.resource.data.status == 'pending';
                              allow read: if isOwner() || (signedIn() && resource.data.email == myEmail());
                              allow update, delete: if isOwner(); }
    match /asks/{id}        { allow read, write: if isTL() || isEmp(id); }
    match /chatRead/{em}    { allow read, write: if signedIn() && em == myEmail(); }
    // اشتراكات الإشعارات: كل واحد بيكتب اشتراكه، والتيم بيقرا (سيرفر الإشعارات بيقرا بصلاحية اللي بعت)
    match /push/{em}        { allow read: if signedIn() && myEmail() in get(/databases/$(database)/documents/chats/team).data.emails;
                              allow write: if signedIn() && em == myEmail(); }
    // المكالمات: الجماعية لكل التيم، والخاصة للاتنين اللي في المحادثة بس
    match /calls/{room}/{rest=**} { allow read, write: if signedIn() && myEmail() in get(/databases/$(database)/documents/chats/$(room)).data.emails; }
    // صفحة العملاء العامة: أي حد يقراها من غير تسجيل، والمدير بس اللي بيعدّل
    match /site/{rest=**}   { allow read: if true; allow write: if isOwner(); }
  }
}
