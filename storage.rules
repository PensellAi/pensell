rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function em() { return request.auth.token.email.lower(); }
    function lead() { return em() in ['ahmedassemads@gmail.com'] || em() in firestore.get(/databases/(default)/documents/cfg/roles).data.get('tl', []); }
    function sees(rid) { return em() in firestore.get(/databases/(default)/documents/reqs/$(rid)).data.see; }
    function clientOf(cid) { return firestore.exists(/databases/(default)/documents/clientUsers/$(em())) && firestore.get(/databases/(default)/documents/clientUsers/$(em())).data.cid == cid; }
    // ملفات طلبات الأكونتات (الريفرنس والتسليم): اللي يشوف الطلب بس
    match /reqs/{rid}/{file} {
      allow read: if request.auth != null && (lead() || sees(rid));
      allow create: if request.auth != null && request.resource.size < 100 * 1024 * 1024 && (lead() || sees(rid));
      allow delete: if request.auth != null && lead();
    }
    // «بيزنسي»: ملفات طلبات العميل وسكرين التحويل
    match /creqs/{cid}/{file} {
      allow read: if request.auth != null && (lead() || clientOf(cid));
      allow create: if request.auth != null && request.resource.size < 100 * 1024 * 1024 && (lead() || clientOf(cid));
      allow delete: if request.auth != null && lead();
    }
    function onAcc(cid) { return em() in firestore.get(/databases/(default)/documents/chats/$('c_' + cid)).data.emails; }
    // «خد رأي العميل»: التيم اللي على الأكونت بيرفع، والعميل بيشوف
    match /cask/{cid}/{file} {
      allow read: if request.auth != null && (lead() || clientOf(cid) || onAcc(cid));
      allow create: if request.auth != null && request.resource.size < 100 * 1024 * 1024 && (lead() || onAcc(cid));
      allow delete: if request.auth != null && lead();
    }
    match /cinv/{cid}/{file} {    match /cinv/{cid}/{file} {
      allow read: if request.auth != null && (lead() || clientOf(cid));
      allow create: if request.auth != null && request.resource.size < 10 * 1024 * 1024 && clientOf(cid);
      allow delete: if request.auth != null && lead();
    }
  }
}
